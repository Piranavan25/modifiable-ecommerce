{
  "Navbar": {
    "purpose": "navigation",
    "description": "Main site navigation bar at the top of the page containing branding, lookup features, and user interaction triggers.",
    "editableProps": ["logoText", "showSearch", "showCart", "showProfile"],
    "editableStyles": [
      "backgroundColor",
      "textColor",
      "logoColor",
      "searchBorderColor",
      "buttonBackgroundColor",
      "buttonTextColor",
      "fontSize",
      "containerMaxWidth",
      "paddingY",
      "shadow"
    ],
    "allowedValues": {
      "showSearch": [true, false],
      "showCart": [true, false],
      "showProfile": [true, false]
    }
  },

  "HeroBanner": {
    "purpose": "marketing",
    "description": "Main promotional carousel sliding banner showing critical marketing campaigns and call-to-actions.",
