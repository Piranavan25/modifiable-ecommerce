    "editableStyles": [
      "sectionBackground",
      "cardBackground",
      "badgeTextColor",
      "titleTextColor",
      "subtitleTextColor",
      "buttonBackgroundColor",
      "buttonTextColor",
      "containerMaxWidth",
      "paddingY",
      "titleSize",
      "subtitleSize"
    ],
    "allowedValues": {
      "imagePosition": ["left", "right"],
      "rounded": [true, false],
      "autoplay": [true, false],
      "showPagination": [true, false],
      "showButton": [true, false],
      "showSubtitle": [true, false],
      "showBadge": [true, false]
    }
  },

